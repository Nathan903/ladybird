+++ b/scripts/cmake/vcpkg_acquire_msys.cmake
@@ -154,6 +154,41 @@ function(z_vcpkg_acquire_msys_collect_hashes out_hash)
 endfunction()
 
 function(vcpkg_acquire_msys out_msys_root)
+    # Ladybird native Windows build: resolve POSIX helpers from Cygwin.
+    # Never execute the MSYS2 download code in this vcpkg checkout.
+    cmake_path(CONVERT "$ENV{LADYBIRD_CYGWIN_ROOT}" TO_CMAKE_PATH_LIST helper_root NORMALIZE)
+    if(helper_root STREQUAL "" OR NOT EXISTS "${helper_root}/usr/bin/bash.exe")
+        message(FATAL_ERROR "Set LADYBIRD_CYGWIN_ROOT to the configured Cygwin build helper directory")
+    endif()
+    cmake_parse_arguments(PARSE_ARGV 1 helper "NO_DEFAULT_PACKAGES;Z_ALL_PACKAGES"
+        "Z_DECLARE_EXTRA_PACKAGES_COMMAND" "PACKAGES;DIRECT_PACKAGES")
+    if(helper_Z_ALL_PACKAGES OR helper_Z_DECLARE_EXTRA_PACKAGES_COMMAND OR helper_DIRECT_PACKAGES
+       OR helper_UNPARSED_ARGUMENTS)
+        message(FATAL_ERROR "Unsupported build helper request from ${PORT}: ${ARGV}")
+    endif()
+    foreach(package IN LISTS helper_PACKAGES)
+        if(package STREQUAL "autoconf-wrapper")
+            set(program autoconf)
+        elseif(package STREQUAL "automake-wrapper")
+            set(program automake)
+        elseif(package STREQUAL "binutils")
+            set(program strip)
+        elseif(package STREQUAL "autoconf-archive")
+            if(NOT EXISTS "${helper_root}/usr/share/aclocal/ax_pthread.m4")
+                message(FATAL_ERROR "Cygwin package autoconf-archive is required by ${PORT}")
+            endif()
+            continue()
+        else()
+            set(program "${package}")
+        endif()
+        if(NOT EXISTS "${helper_root}/usr/bin/${program}.exe"
+           AND NOT EXISTS "${helper_root}/usr/bin/${program}")
+            message(FATAL_ERROR "Cygwin build helper ${package} (${program}) is required by ${PORT}")
+        endif()
+    endforeach()
+    message(STATUS "Using Cygwin build helpers for ${PORT}")
+    set("${out_msys_root}" "${helper_root}" PARENT_SCOPE)
+    return()
     cmake_parse_arguments(PARSE_ARGV 1 "arg"
         "NO_DEFAULT_PACKAGES;Z_ALL_PACKAGES"
         "Z_DECLARE_EXTRA_PACKAGES_COMMAND"
